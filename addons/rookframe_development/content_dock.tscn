[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/rookframe_development/content_dock.gd" id="1"]

[node name="RookframeContent" type="EditorDock"]
title = "Rookframe Content"
default_slot = 4
layout_key = "rookframe_content"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 8

[node name="Scroll" type="ScrollContainer" parent="Margin"]
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Margin/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Subject" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
text = "Select Content"
text_overrun_behavior = 3

[node name="SourcePath" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
text_overrun_behavior = 3

[node name="Separator" type="HSeparator" parent="Margin/Scroll/Content"]

[node name="Empty" type="Label" parent="Margin/Scroll/Content"]
unique_name_in_owner = true
autowrap_mode = 3
