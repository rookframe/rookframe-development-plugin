[gd_scene load_steps=3 format=3]
[ext_resource type="Script" path="res://addons/rookframe_development/development.gd" id="1"]
[ext_resource type="PackedScene" path="res://addons/rookframe_development/authoring.tscn" id="author"]

[node name="Rookframe" type="EditorDock"]
title = "Rookframe"
default_slot = 4
layout_key = "rookframe_development"

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 8
[node name="Body" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 16
[node name="Package" parent="Margin/Body" instance=ExtResource("author")]
[node name="Separator" type="HSeparator" parent="Margin/Body"]
[node name="Development" type="VBoxContainer" parent="Margin/Body"]
script = ExtResource("1")
theme_override_constants/separation = 8
[node name="Title" type="Label" parent="Margin/Body/Development"]
text = "Development World"
[node name="WorldSummary" type="Label" parent="Margin/Body/Development"]
unique_name_in_owner = true
text = "Not configured"
text_overrun_behavior = 3
[node name="Configure" type="Button" parent="Margin/Body/Development"]
unique_name_in_owner = true
text = "Set up World…"
[node name="Status" type="Label" parent="Margin/Body/Development"]
unique_name_in_owner = true
autowrap_mode = 3

[node name="WorldSettings" type="Window" parent="Margin/Body/Development"]
unique_name_in_owner = true
title = "Development World"
size = Vector2i(620, 570)
transient = true
exclusive = true
visible = false
wrap_controls = false
[node name="Margin" type="MarginContainer" parent="Margin/Body/Development/WorldSettings"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_bottom = 16
[node name="Scroll" type="ScrollContainer" parent="Margin/Body/Development/WorldSettings/Margin"]
horizontal_scroll_mode = 0
[node name="Form" type="VBoxContainer" parent="Margin/Body/Development/WorldSettings/Margin/Scroll"]
size_flags_horizontal = 3
theme_override_constants/separation = 10
[node name="WorldLabel" type="Label" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
text = "World name"
[node name="WorldName" type="LineEdit" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
text = "Package development"
[node name="WorldHelp" type="Label" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
text = "Reuse this name to keep your saved World."
[node name="RuntimeLabel" type="Label" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
text = "Installed Rookframe application"
[node name="RuntimeRow" type="HBoxContainer" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
[node name="Runtime" type="LineEdit" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form/RuntimeRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "Rookframe executable"
[node name="Browse" type="Button" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form/RuntimeRow"]
unique_name_in_owner = true
text = "Choose…"
[node name="UsePackage" type="CheckBox" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
text = "Edit this project's Package"
disabled = true
[node name="PackageStatus" type="Label" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
autowrap_mode = 3
[node name="SystemLabel" type="Label" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
text = "Published System Manifest URL"
[node name="SystemManifest" type="LineEdit" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
placeholder_text = "https://…"
[node name="PackagesLabel" type="Label" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
text = "Other published Packages (optional, one Manifest URL per line)"
autowrap_mode = 3
[node name="Packages" type="TextEdit" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 90)
size_flags_vertical = 3
placeholder_text = "https://…"
[node name="Prepare" type="Button" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
text = "Save and prepare World"

[node name="ConfigStatus" type="Label" parent="Margin/Body/Development/WorldSettings/Margin/Scroll/Form"]
unique_name_in_owner = true
autowrap_mode = 3

[node name="PreparationError" type="AcceptDialog" parent="Margin/Body/Development"]
unique_name_in_owner = true
title = "World preparation failed"
dialog_autowrap = true

[node name="RuntimePicker" type="FileDialog" parent="Margin/Body/Development"]
unique_name_in_owner = true
title = "Choose installed Rookframe"
file_mode = 0
access = 2
[node name="Restart" type="ConfirmationDialog" parent="Margin/Body/Development"]
unique_name_in_owner = true
title = "Activate Development World"
dialog_text = "Save and reopen this editor once so Godot activates its launch settings.\nAfter that, use normal Play (F5). Saved Package edits reload in the running World."
ok_button_text = "Save and reopen editor"
