[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://addons/rookframe_development/authoring.gd" id="1"]

[node name="Package" type="VBoxContainer"]
script = ExtResource("1")
theme_override_constants/separation = 10

[node name="Create" type="Button" parent="."]
unique_name_in_owner = true
text = "Create Package…"

[node name="PackageHeader" type="VBoxContainer" parent="."]
unique_name_in_owner = true
theme_override_constants/separation = 4
[node name="PackageTitle" type="Label" parent="PackageHeader"]
unique_name_in_owner = true
text = "Package"
text_overrun_behavior = 3
[node name="SettingsMenu" type="MenuButton" parent="PackageHeader"]
unique_name_in_owner = true
text = "Package settings"
alignment = 0

[node name="PackageActions" type="HBoxContainer" parent="."]
unique_name_in_owner = true
[node name="Check" type="Button" parent="PackageActions"]
unique_name_in_owner = true
size_flags_horizontal = 3
text = "Check"
tooltip_text = "Check saved Package sources with the installed Rookframe application"
[node name="Build" type="Button" parent="PackageActions"]
unique_name_in_owner = true
size_flags_horizontal = 3
text = "Build…"
tooltip_text = "Build a checked Package archive"

[node name="Conflict" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
[node name="ConflictText" type="Label" parent="Conflict"]
unique_name_in_owner = true
autowrap_mode = 3
[node name="CopyDraft" type="Button" parent="Conflict"]
unique_name_in_owner = true
text = "Copy unsaved draft"
[node name="Reload" type="Button" parent="Conflict"]
unique_name_in_owner = true
text = "Discard draft and reload file"

[node name="Setup" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Create a Rookframe Package"
ok_button_text = "Create Package"
[node name="Scroll" type="ScrollContainer" parent="Setup"]
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Form" type="VBoxContainer" parent="Setup/Scroll"]
size_flags_horizontal = 3
theme_override_constants/separation = 12
[node name="NameLabel" type="Label" parent="Setup/Scroll/Form"]
text = "Package name"
[node name="PackageName" type="LineEdit" parent="Setup/Scroll/Form"]
unique_name_in_owner = true
placeholder_text = "Name shown to people installing your Package"
[node name="StartingPointLabel" type="Label" parent="Setup/Scroll/Form"]
text = "Choose a starting point"
[node name="StartingPointDescription" type="Label" parent="Setup/Scroll/Form"]
text = "Every package can contain content. These options prepare different starting files."
autowrap_mode = 3
[node name="ContentChoice" type="CheckBox" parent="Setup/Scroll/Form"]
unique_name_in_owner = true
text = "Content pack"
[node name="ContentDescription" type="Label" parent="Setup/Scroll/Form"]
text = "Start with scenes and Resources: miniatures, props, wall styles and more. No code required. You can add behavior and UI later."
autowrap_mode = 3
[node name="ExtensionChoice" type="CheckBox" parent="Setup/Scroll/Form"]
unique_name_in_owner = true
text = "Extension"
[node name="ExtensionDescription" type="Label" parent="Setup/Scroll/Form"]
text = "Start with GDScript behavior that adds features to a World. Your package can also include content and UI."
autowrap_mode = 3
[node name="SystemChoice" type="CheckBox" parent="Setup/Scroll/Form"]
unique_name_in_owner = true
text = "Game system"
[node name="SystemDescription" type="Label" parent="Setup/Scroll/Form"]
text = "Define a game's rules, Actors and shared data, together with its content and UI. A World uses exactly one game system."
autowrap_mode = 3
[node name="PackageRoles" type="Label" parent="Setup/Scroll/Form"]
text = "Content packs and extensions are optional additions to a World."
autowrap_mode = 3
[node name="StarterUI" type="CheckBox" parent="Setup/Scroll/Form"]
unique_name_in_owner = true
visible = false
text = "Include an editable UI window"
[node name="SetupError" type="Label" parent="Setup/Scroll/Form"]
unique_name_in_owner = true
autowrap_mode = 3

[node name="Settings" type="ConfirmationDialog" parent="."]
