text = "Device UI"
[node name="UIHelp" type="Label" parent="Settings/Form/SettingsTabs/Code & UI/Form"]
text = "Each entry extends Control and implements compose_presentation(host). Build its scene normally in Godot.\nA device has one entry. Without a specific entry, phone falls back to tablet, then desktop."
autowrap_mode = 3
